#!/usr/bin/env python3
#
# Add and commit all package files
#

import git


def main() -> None:
    """Add and commit all package files."""
    repo = git.Repo()

    if not repo.git.status("--porcelain", "--", "ubuntu/package/"):
        print("II: No package files changes to commit")
        return

    print("II: Commit package files")

    repo.git.add("ubuntu/package/", "ubuntu/unpackaged")
    # fmt: off
    repo.git.commit(
        "-s",
        "-m", "UBUNTU: [Packaging] Update package files",
        "-m", "Ignore: yes",
    )
    # fmt: on


if __name__ == "__main__":
    main()
