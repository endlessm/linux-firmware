#!/bin/bash -eu
#
# Add and commit all package files
#

if [ -z "$(git status --porcelain -- ubuntu/package/)" ] ; then
	echo "II: No package files changes to commit"
	exit 0
fi

echo "II: Commit package files"

git add ubuntu/package/
git commit -s -m "UBUNTU: [Packaging] Update package files" -m "Ignore: yes"
