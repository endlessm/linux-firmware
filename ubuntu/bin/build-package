#!/usr/bin/env python3
#
# Build package
#

import argparse
import io
import shutil
import subprocess
import sys
import tarfile
from pathlib import Path

import git

from lib.changelog import ChangelogError
from lib.git_files import GitFiles, GitFilesError
from lib.package import Package, PackageError


def _extract(repo: git.Repo, commit: str, path: str | list[str], dest: Path) -> None:
    """Extract files from git at commit into dest."""
    buf = io.BytesIO()
    if isinstance(path, str):
        repo.git.archive(f"{commit}:{path}", format="tar", output_stream=buf)
    else:
        repo.git.archive(commit, "--", *path, format="tar", output_stream=buf)
    buf.seek(0)
    with tarfile.open(fileobj=buf) as tf:
        tf.extractall(dest, filter="tar")


def main() -> None:
    """Build a Debian package."""
    argv = sys.argv[1:]
    if "--" in argv:
        idx = argv.index("--")
        main_argv = argv[:idx]
        dpkg_args = argv[idx + 1 :]
    else:
        main_argv = argv
        dpkg_args = []

    parser = argparse.ArgumentParser(
        description="Build package",
        usage="%(prog)s [--force] [--suffix SUFFIX] <package> [<commit>] [-- <dpkg-buildpackage options>...]",
    )
    parser.add_argument("package", help="Package name")
    parser.add_argument("commit", nargs="?", default=None, help="Build commit (default: last release commit)")
    parser.add_argument("--force", action="store_true", help="Force build from untagged commit")
    parser.add_argument("--suffix", help="Append suffix to package version")
    args = parser.parse_args(main_argv)

    print(f"II: Build package: {args.package}")

    # Determine build commit
    commit = args.commit
    if not commit:
        try:
            commit = Package(args.package).changelog.release_commit
        except (PackageError, ChangelogError, GitFilesError) as e:
            print(f"EE: {e}", file=sys.stderr)
            sys.exit(2)

    if not commit:
        print("EE: Build commit not found", file=sys.stderr)
        sys.exit(1)

    build_pkg = Package(args.package, commit)

    if str(build_pkg.changelog.Changelog.version).endswith(".0"):
        print("II: Skip dummy SRU release version")
        sys.exit(0)

    repo = git.Repo()
    summary = repo.git.log('--format=%h ("%s")', commit, "-1")
    print(f"II: Build package from commit: {summary}")

    if not args.force:
        try:
            repo.git.describe("--exact-match", commit)
        except git.GitCommandError:
            print("EE: Build commit is untagged, use --force to ignore", file=sys.stderr)
            sys.exit(1)

    # Set up build directory
    source_name = str(build_pkg.changelog.Changelog.package)
    build_dir = Path("ubuntu/build") / source_name
    if build_dir.exists():
        shutil.rmtree(build_dir)

    if args.package == "meta":
        # Meta package: just copy packaging files
        print("II: Copy packaging files")
        debian_dir = build_dir / "debian"
        debian_dir.mkdir(parents=True)
        _extract(repo, commit, "ubuntu/package/meta", debian_dir)
    else:
        # Regular package: firmware + packaging

        print("II: Copy firmware files")
        build_dir.mkdir(parents=True)
        _extract(repo, commit, build_pkg.content.paths(), build_dir)

        print("II: Copy packaging files")
        debian_dir = build_dir / "debian"
        debian_dir.mkdir(exist_ok=True)
        _extract(repo, commit, "ubuntu/debian", debian_dir)
        _extract(repo, commit, f"ubuntu/package/{args.package}", debian_dir)

        print("II: Fix packaging files")

        # Create debian/control
        gf = GitFiles(commit)
        source_in = gf.read("ubuntu/templates/control.source.in")
        pkg_control = gf.read(f"ubuntu/package/{args.package}/control")
        control = f"{source_in}\n\n{pkg_control}\n".replace("@package@", args.package)
        (debian_dir / "control").write_text(control, encoding="utf-8")

        # Rename files containing @package@ in their name
        for path in sorted(debian_dir.rglob("*@package@*"), reverse=True):
            path.rename(path.with_name(path.name.replace("@package@", args.package)))

        # Remove unwanted files
        for name in ("files", "README"):
            unwanted = debian_dir / name
            if unwanted.exists():
                unwanted.unlink()

    # Apply version suffix
    changelog_path = build_dir / "debian" / "changelog"
    version = str(build_pkg.changelog.Changelog.version)
    if args.suffix:
        text = changelog_path.read_text(encoding="utf-8")
        text = text.replace(f"({version})", f"({version}{args.suffix})", 1)
        changelog_path.write_text(text, encoding="utf-8")
        version = f"{version}{args.suffix}"

    # Link the orig tarball into the build directory
    orig_version = version.split("-")[0]
    orig_tarball = f"{source_name}_{orig_version}.orig.tar.xz"
    orig_source = Path("..") / orig_tarball
    orig_link = Path("ubuntu/build") / orig_tarball

    if orig_source.exists() and not orig_link.is_symlink():
        # Symlink target is relative to ubuntu/build/
        orig_link.symlink_to(Path("../../..") / orig_tarball)

    # Build the package
    print("II: Build package")
    subprocess.run(["dpkg-buildpackage", *dpkg_args], check=True, cwd=build_dir)

    # Copy build artifacts to ../
    output_dir = Path("..")
    for pattern in (f"{source_name}_{version}.*", f"{source_name}_{version}_*"):
        for artifact in Path("ubuntu/build").glob(pattern):
            shutil.copy2(artifact, output_dir)


if __name__ == "__main__":
    main()
