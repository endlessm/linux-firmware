#!/bin/bash -eu
#
# Build package
#

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

function usage()
{
	cat <<EOF
Usage: $(basename "${0}") [-h] <package> [<commit>] [-- <dpkg-buildpackage option>...]

Postional arguments:
  <package>   Name of the package to work on.
  <commit>    Commit to build the package from. If not provided, uses the last
              release commit.

Optional arguments:
  -h, --help  Show this help text and exit.
EOF
}

package=
commit=

while [ ${#} -gt 0 ] ; do
	case "${1}" in
		-h|--help)
			usage
			exit
			;;
		--)
			shift
			break
			;;
		-*)
			usage >&2
			exit 2
			;;
		*)
			if [ -z "${package}" ] ; then
				package=${1}
			elif [ -z "${commit}" ] ; then
				commit=${1}
			else
				echo "EE: Invalid argument: ${1}" >&2
				exit 2
			fi
			;;
	esac
	shift
done

if [ -z "${package}" ] ; then
	usage >&2
	exit 2
fi

case "${package}" in
	meta)
		is_meta=1
		changelog=ubuntu/meta/debian/changelog
		;;
	*)
		is_meta=0
		changelog=ubuntu/package/${package}/changelog
		;;
esac

if ! [ -e "${changelog}" ] ; then
	echo "EE: Invalid package name: ${package}" >&2
	exit 2
fi

trap out EXIT INT TERM HUP

echo "II: Build package: ${package}"

package_name=$(dpkg-parsechangelog -l "${changelog}" -S Source)
build_dir=ubuntu/build/"${package_name}"
rm -rf "${build_dir}"

#
# Determine the build commit
#

if [ -z "${commit}" ] ; then
	blame=$(git blame -L 1,1 "${changelog}" || true)
	commit=${blame%% *}
fi

if [ -z "${commit}" ] ; then
	echo "EE: Build commit not found" >&2
	exit 1
fi

echo "II: Build package from commit: ${commit}"

if [ ${is_meta} -eq 1 ] ; then

	#
	# Copy packaging files
	#

	echo "II: Copy packaging files"

	mkdir -p "${build_dir}"/debian

	git -C ubuntu/"${package}"/debian archive --format=tar "${commit}" -- . | tar -C "${build_dir}"/debian/ -xf -

else

	#
	# Copy firmware files
	#

	echo "II: Copy firmware files"

	mkdir -p "${build_dir}"

	readarray -t package_files < <(grep '^[0-9a-zA-Z:]' ubuntu/package/"${package}"/files)
	git archive --format=tar "${commit}" -- "${package_files[@]}" | tar -C "${build_dir}" -xf -

	#
	# Copy packaging files
	#

	echo "II: Copy packaging files"

	mkdir -p "${build_dir}"/debian

	git -C ubuntu/debian archive --format=tar "${commit}" -- . | tar -C "${build_dir}"/debian/ -xf -
	git -C ubuntu/package/"${package}" archive --format=tar "${commit}" -- . | tar -C "${build_dir}"/debian/ -xf -

	#
	# Fix packaging files
	#

	echo "II: Fix packaging files"

	{
		git show "${commit}":ubuntu/templates/control.source.in
		echo
		git show "${commit}":ubuntu/package/"${package}"/control
	} | sed -e "s/@package@/${package}/" > "${build_dir}"/debian/control

	while IFS= read -r f ; do
		mv "${f}" "${f/@package@/${package}}"
	done < <(find "${build_dir}"/debian/ -name '*@package@*')

	#
	# Remove unwanted files
	#

	for f in debian/files ; do
		rm -f "${build_dir}"/"${f}"
	done

fi

#
# Package version
#

version=$(dpkg-parsechangelog -l "${build_dir}"/debian/changelog -S Version)

#
# Link the orig tarball into the build directory
#

orig_tarball=${package_name}_${version%%-*}.orig.tar.xz
if [ -e ../"${orig_tarball}" ] && ! [ -h ubuntu/build/"${orig_tarball}" ] ; then
	ln -s  ../../../"${orig_tarball}" ubuntu/build/"${orig_tarball}"
fi

#
# Finally, do the actual package build
#

echo "II: Build package"

cd ubuntu/build/"${package_name}"

dpkg-buildpackage "${@}"

for f in ../"${package_name}"_"${version}"{.,_}* ; do
	if [ -e "${f}" ] ; then
		cp "${f}" ../../../../
	fi
done
