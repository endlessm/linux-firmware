#!/usr/bin/env python3
#
# Tag a release commit
#

import argparse
import sys

import git


def main() -> None:
    """Tag a release commit."""
    parser = argparse.ArgumentParser(description="Tag a release commit")
    parser.add_argument("commit", nargs="?", default="HEAD", help="Commit to tag (default: HEAD)")
    parser.add_argument("--force", action="store_true", help="Force tagging")
    args = parser.parse_args()

    repo = git.Repo()

    try:
        subject = repo.git.log("--format=%s", args.commit, "-1")
    except git.GitCommandError as e:
        print(f"EE: {e}", file=sys.stderr)
        sys.exit(1)

    if not subject.startswith("UBUNTU: Ubuntu-"):
        print(f'EE: Not a release commit: {args.commit} ("{subject}")', file=sys.stderr)
        sys.exit(1)

    tag = subject.removeprefix("UBUNTU: ").replace("~", "_")
    print(f"II: Tag commit {args.commit} with: {tag}")

    tag_args = ["-s", "-m", subject, tag, args.commit]
    if args.force:
        tag_args.insert(0, "--force")

    try:
        repo.git.tag(*tag_args)
    except git.GitCommandError as e:
        print(f"EE: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
