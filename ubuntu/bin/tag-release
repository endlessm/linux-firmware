#!/bin/bash -eu
#
# Tag a release commit
#

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

function usage()
{
	cat <<EOF
Usage: $(basename "${0}") [--force] [-h] [<commit>]

Tag the given commit or HEAD.

Postional arguments:
  <commit>    Commit to tag. If not provided, tags HEAD.

Optional arguments:
  --force     Force things.
  -h, --help  Show this help text and exit.
EOF
}

opts=()
commit=

while [ ${#} -gt 0 ] ; do
	case "${1}" in
		--force)
			opts+=(--force)
			;;
		-h|--help)
			usage
			exit
			;;
		-*)
			usage >&2
			exit 2
			;;
		*)
			if [ -z "${commit}" ] ; then
				commit=${1}
			else
				echo "EE: Invalid argument: ${1}" >&2
				exit 2
			fi
			;;
	esac
	shift
done

trap out EXIT INT TERM HUP

commit=${commit:-HEAD}
subject=$(git log --format=%s "${commit}" -1)

case "${subject}" in
	"UBUNTU: Ubuntu-"*)
		tag=${subject#UBUNTU: }
		tag=${tag//~/_}
		echo "II: Tag commit ${commit} with: ${tag}"
		git tag "${opts[@]}" -s -m "${subject}" "${tag}" "${commit}"
		;;
	*)
		echo "EE: Not a release commit: ${commit} (\"${subject}\")" >&2
		exit 1
		;;
esac
