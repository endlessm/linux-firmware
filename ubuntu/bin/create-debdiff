#!/bin/bash -eu
#
# Create debdiff
#

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

if [ $# -lt 1 ] || [ $# -gt 2 ] ; then
	echo "Usage: $(basename "${0}") <package> [<offset>]" >&2
	exit 2
fi

package=${1}
offset=${2:-}

changelog=ubuntu/package/${package}/changelog
if ! [ -e "${changelog}" ] ; then
	echo "EE: Invalid package name: ${package}" >&2
	exit 1
fi

echo "II: Create debdiff for package: ${package}"

trap out EXIT INT TERM HUP

name=$(dpkg-parsechangelog -l "${changelog}" -S Source)
curr_version=$(dpkg-parsechangelog -l "${changelog}" -S Version)
if [ "${curr_version%.0}" != "${curr_version}" ] ; then
	echo "II: Skip dummy SRU release version"
	exit 0
fi

if [ -n "${offset}" ] ; then
	prev_version=$(dpkg-parsechangelog -l "${changelog}" -S Version -o "${offset}" -c 1)
else
	prev_version=$(dpkg-parsechangelog -l "${changelog}" -S Version -o 1 -c 1)
	if [ "${prev_version%.0}" != "${prev_version}" ] ; then
		# Skip dummy SRU release version
		prev_version=$(dpkg-parsechangelog -l "${changelog}" -S Version -o 2 -c 1)
	fi
fi

curr_base=../${name}_${curr_version}
prev_base=../${name}_${prev_version}

outfile=${curr_base}.debdiff
echo "II: Create ${outfile}"
debdiff "${prev_base}".dsc "${curr_base}".dsc > "${outfile}" || true
