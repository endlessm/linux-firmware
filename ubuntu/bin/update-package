#!/usr/bin/env python3
#
# Update package
#

import argparse
import sys

from lib.changelog import ChangelogError
from lib.package import Package, PackageError
from lib.whence import Whence, WhenceError


def main() -> None:
    """Update a package's WHENCE, patches, and include-binaries files."""
    parser = argparse.ArgumentParser(description="Update package")
    parser.add_argument("package", help="Package name")
    parser.add_argument(
        "commit",
        nargs="?",
        default="HEAD",
        help="Commit to read package files at (default: HEAD)",
    )
    args = parser.parse_args()

    print(f"II: Update package: {args.package}")

    if args.package == "meta":
        return

    try:
        pkg = Package(args.package, args.commit)
        package_files = pkg.files

        # Update WHENCE
        print("II: Update WHENCE")
        whence = Whence("WHENCE*", args.commit)
        pkg.whence.update(package_files, whence)

        # Update Debian delta (patches and binaries)
        print("II: Update Debian delta")
        pkg.update_delta()

    except (PackageError, WhenceError, ChangelogError) as e:
        print(f"EE: {e}", file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError) as e:
        print(f"EE: Script failed: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
