#!/bin/bash -eu
#
# Review debdiff
#

COLS=$(tput cols)

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

function colorize()
{
	local line color

	while IFS= read -r line ; do
		case "${line}" in
			"-"*)     color="\e[31m" ;;
			"+"*)     color="\e[32m" ;;
			"!"*)     color="\e[33m" ;;
			"@@"*)    color="\e[36m" ;;
			"diff "*) color="\e[1m\e[36m" ;;
			"II: "*)  color="\e[96m" ;;
			"WW: "*)  color="\e[93m" ;;
			*)        color="" ;;
		esac

		if [ -n "${color}" ] ; then
			echo -e "${color}${line}\e[0m"
		else
			echo "${line}"
		fi
	done
}

function header()
{
	printf "II: "; printf '%.0s-' $(seq 6 "${COLS}"); printf "\n"
	echo "II: ${*}"
	printf "II: "; printf '%.0s-' $(seq 6 "${COLS}"); printf "\n"
	echo
}

function usage()
{
	cat <<EOF
Usage: $(basename "${0}") [-h] [--no-whence] <package>

Postional arguments:
  <package>    Name of the package to work on.

Optional arguments:
  -h, --help   Show this help text and exit.
  --no-whence  Don't show WHENCE differences.
EOF
}

no_whence=0
package=

while [ ${#} -gt 0 ] ; do
	case "${1}" in
		-h|--help)
			usage
			exit
			;;
		--no-whence)
			no_whence=1
			;;
		-*)
			usage >&2
			exit 2
			;;
		*)
			if [ -n "${package}" ] ; then
				echo "EE: Invalid argument: ${1}" >&2
				exit 2
			fi
			package=${1}
			;;
	esac
	shift
done

if [ -z "${package}" ] ; then
	usage >&2
	exit 2
fi

case "${package}" in
	meta)
		changelog=ubuntu/meta/debian/changelog
		;;
	*)
		changelog=ubuntu/package/${package}/changelog
		;;
esac

if ! [ -e "${changelog}" ] ; then
	echo "EE: Invalid package name: ${package}" >&2
	exit 1
fi

echo "II: Review debdiff for package: ${package}"

trap out EXIT INT TERM HUP

name=$(dpkg-parsechangelog -l "${changelog}" -S Source)
version=$(dpkg-parsechangelog -l "${changelog}" -S Version)

debdiff=../${name}_${version}.debdiff

if [ ! -e "${debdiff}" ] ; then
	echo "EE: Debdiff not found: ${debdiff}" >&2
	exit 1
fi

# Filter-out WHENCE
whence=$(lsdiff "${debdiff}" | grep '^[^/]*/WHENCE' || true)
if [ -n "${whence}" ] && [ ${no_whence} -eq 1 ] ; then
	filterdiff=("filterdiff" "-x" "${whence}")
else
	filterdiff=("cat")
fi

{
	header "lsdiff -s ${debdiff}"
	lsdiff -s "${debdiff}"
	echo

	header "${filterdiff[*]} ${debdiff}"
	"${filterdiff[@]}" "${debdiff}"
	echo

} | colorize

changes=../${name}_${version}_source.changes
header "cat ${changes}" | colorize
cat "${changes}"
echo
