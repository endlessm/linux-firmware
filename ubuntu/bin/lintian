#!/bin/bash -eu
#
# Run lintian on a package
#

function run_lintian()
{
	# FIXME: We should add a proper lintian.overrides file to the source package
	lintian \
		-X binaries \
		--tag-display-limit 0 \
		--suppress-tags binary-with-bad-dynamic-table,elf-error,package-has-long-file-name \
		--color always \
		"${@}" 2> >(grep -v "Parse error in readelf") | \
		grep -vE "file-without-copyright-information.* (LICENSES/|WHENCE)"
}

pkg=${1}
shift

echo "II: Run lintian on package: ${pkg}"

changelog=ubuntu/package/"${pkg}"/changelog

s=$(dpkg-parsechangelog -l "${changelog}" -S Source)
v=$(dpkg-parsechangelog -l "${changelog}" -S Version)

basename=${s}_${v}
changes=../${basename}_source.changes
if [ -e "${changes}" ] ; then
	run_lintian "${@}" "${changes}"
	exit 0
fi

dsc=../${basename}.dsc
if [ -e "${dsc}" ] ; then
	run_lintian "${@}" "${dsc}"
	exit 0
fi

echo "EE: Not found: ../${basename}{_source.changes,.dsc}" >&2
exit 1
