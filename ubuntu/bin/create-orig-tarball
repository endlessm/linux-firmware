#!/usr/bin/env python3
#
# Create an orig tarball for a package
#

import argparse
import subprocess
import sys
from pathlib import Path

from lib.changelog import ChangelogError
from lib.package import Package, PackageError


def main() -> None:
    """Create an orig tarball for a package."""
    parser = argparse.ArgumentParser(description="Create an orig tarball for a package")
    parser.add_argument("package", help="Package name")
    parser.add_argument("commit", nargs="?", default="HEAD", help="Commit to read package files at (default: HEAD)")
    parser.add_argument("--force", action="store_true", help="Overwrite existing tarball")
    args = parser.parse_args()

    try:
        pkg = Package(args.package, args.commit)
    except (PackageError, ChangelogError) as e:
        print(f"EE: {e}", file=sys.stderr)
        sys.exit(1)

    if pkg.is_native:
        print(f"II: No orig tarball needed for package: {args.package}")
        return

    print(f"II: Create orig tarball for package: {args.package}")

    orig = pkg.orig
    orig_tarball = Path(f"../{orig.source_name}_{orig.upstream_version}.orig.tar")
    orig_tarball_xz = Path(f"{orig_tarball}.xz")

    if args.force:
        orig_tarball_xz.unlink(missing_ok=True)
    if orig_tarball_xz.exists():
        print(f"II: Orig tarball exists already: {orig_tarball_xz}")
        return

    # Create tarball
    print(f"II: Create {orig_tarball_xz}")
    prefix = f"{orig.source_name}-{orig.upstream_version}/"
    try:
        subprocess.run(
            [
                "git",
                "archive",
                "--format=tar",
                f"--prefix={prefix}",
                "-o",
                str(orig_tarball),
                orig.upstream_commit,
                "--",
            ]
            + orig.content.paths(),
            check=True,
        )
        subprocess.run(["xz", str(orig_tarball)], check=True)
    except subprocess.CalledProcessError:
        orig_tarball.unlink(missing_ok=True)
        orig_tarball_xz.unlink(missing_ok=True)
        print("EE: Failed to create tarball", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
