#!/bin/bash -eu
#
# Create an orig tarball for the provided package
#

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

function usage()
{
	cat <<EOF
Usage: $(basename "${0}") [--force] [-h] <package>

Postional arguments:
  <package>   Name of the package to work on.

Optional arguments:
  --force     Overwrite an already existing tarball.
  -h, --help  Show this help text and exit.
EOF
}

force=0
package=

while [ ${#} -gt 0 ] ; do
	case "${1}" in
		-h|--help)
			usage
			exit
			;;
		--force)
			force=1
			;;
		-*)
			usage >&2
			exit 2
			;;
		*)
			if [ -n "${package}" ] ; then
				echo "EE: Invalid argument: ${1}" >&2
				exit 2
			fi
			package=${1}
			;;
	esac
	shift
done

if [ -z "${package}" ] ; then
	usage >&2
	exit 2
fi

if [ "${package}" = "meta" ] ; then
	echo "II: No orig tarball needed for package: ${package}"
	exit 0
fi

if ! [ -e ubuntu/package/"${package}"/control ] ; then
	echo "EE: Invalid package name: ${package}" >&2
	exit 2
fi

echo "II: Create orig tarball for package: ${package}"

trap out EXIT INT TERM HUP

# Current upstream commit and version
COMMIT=
VERSION=
# shellcheck disable=SC1091
. ubuntu/upstream

orig_tarball=../linux-firmware-${package}_${VERSION}.orig.tar.xz
if [ ${force} -eq 1 ] ; then
	rm -f "${orig_tarball}"
fi
if [ -e "${orig_tarball}" ] ; then
	echo "II: Orig tarball exists already: ${orig_tarball}"
	exit
fi

# FIMXE: Check that we are on a tagged release commit

# Construct the list of package files to include in the orig tarball
# FIXME: Is there an easier way to do this?
readarray -t package_files < <({
	./ubuntu/bin/list-package-files "${package}"
	git ls-tree -r --name-only "${COMMIT}"
} | sort | uniq -d)

echo "II: Create ${orig_tarball}"
git archive --format=tar --prefix="linux-firmware-${package}-${VERSION}"/ "${COMMIT}" -- \
    "${package_files[@]}" WHENCE | xz -z - > "${orig_tarball}"
