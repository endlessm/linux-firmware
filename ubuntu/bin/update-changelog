#!/usr/bin/env python3
#
# Update a package changelog
#

import argparse
import sys

from lib.changelog import ChangelogError
from lib.package import Package, PackageError


def main() -> None:
    """Update a package changelog."""
    parser = argparse.ArgumentParser(description="Update a package changelog")
    parser.add_argument("package", help="Package name")
    parser.add_argument("--rebuild", action="store_true", help="No-change rebuild")
    parser.add_argument("--series", help="Ubuntu series name")
    parser.add_argument("--sru", action="store_true", help="Add a dummy SRU changelog entry")
    args = parser.parse_args()

    try:
        pkg = Package(args.package)
        print(f"II: Update changelog of package: {args.package}")
        if not pkg.changelog.update(
            pkg.upstream_version,
            pkg.tracked_paths,
            series=args.series,
            sru=args.sru,
            rebuild=args.rebuild,
        ):
            print("II: No changes")
    except (PackageError, ChangelogError) as e:
        print(f"EE: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
