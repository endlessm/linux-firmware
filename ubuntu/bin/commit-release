#!/bin/bash -eu
#
# Commit and tag a package release
#

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

function usage()
{
	cat <<EOF
Usage: $(basename "${0}") [-h] [--no-check] <package>

Postional arguments:
  <package>   Name of the package to work on.

Optional arguments:
  -h, --help  Show this help text and exit.
  --no-check  Don't run package checks.
EOF
}

no_check=0
package=

while [ ${#} -gt 0 ] ; do
	case "${1}" in
		-h|--help)
			usage
			exit
			;;
		--no-check)
			no_check=1
			;;
		-*)
			usage >&2
			exit 2
			;;
		*)
			if [ -z "${package}" ] ; then
				package=${1}
			else
				usage >&2
				exit 2
			fi
			;;
	esac
	shift
done

if [ -z "${package}" ] ; then
	usage >&2
	exit 2
fi

changelog=ubuntu/package/${package}/changelog
if ! [ -e "${changelog}" ] ; then
	echo "EE: Invalid package name: ${package}" >&2
	exit 1
fi

trap out EXIT INT TERM HUP

if [ -z "$(git status --porcelain -- "${changelog}")" ] ; then
	echo "II: No changelog changes to commit"
	exit 0
fi

# Sanity check
if [ ${no_check} -eq 0 ] ; then
	./ubuntu/bin/check-package--all
fi

echo "II: Commit release"

version=$(dpkg-parsechangelog -l "${changelog}" -S Version)
tag=Ubuntu-${package}-${version}

git add "${changelog}"
git commit -s -m "UBUNTU: ${tag}"

ubuntu/bin/tag-release
