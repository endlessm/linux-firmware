#!/usr/bin/env python3
#
# Commit and tag a package release
#

import argparse
import subprocess
import sys

import git

from lib.changelog import ChangelogError
from lib.package import Package, PackageError


def main() -> None:
    """Commit and tag a package release."""
    parser = argparse.ArgumentParser(description="Commit and tag a package release")
    parser.add_argument("package", help="Package name")
    parser.add_argument("--no-check", action="store_true", help="Don't run package checks")
    parser.add_argument("--no-tag", action="store_true", help="Don't tag the release")
    parser.add_argument("--force", action="store_true", help="Force tagging")
    args = parser.parse_args()

    try:
        pkg = Package(args.package)
    except (PackageError, ChangelogError) as e:
        print(f"EE: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"II: Commit release of package: {args.package}")

    repo = git.Repo()

    if not repo.git.status("--porcelain", "--", str(pkg.changelog.path)):
        print("II: No changelog changes to commit")
        return

    if not args.no_check:
        result = subprocess.run(["./ubuntu/bin/check-packages"], check=False)
        if result.returncode != 0:
            sys.exit(result.returncode)

    version = str(pkg.changelog.Changelog.version)
    tag = f"Ubuntu-{args.package}-{version}"

    repo.git.add(str(pkg.changelog.path))
    repo.git.commit("-s", "-m", f"UBUNTU: {tag}")

    if not args.no_tag:
        force = ["--force"] if args.force else []
        subprocess.run(["./ubuntu/bin/tag-release", *force], check=True)


if __name__ == "__main__":
    main()
