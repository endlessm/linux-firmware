#!/usr/bin/env python3
#
# Check all packages
#

import argparse
import sys
from pathlib import Path

import git

from lib.package import Package, PackageError, PackageFiles


def main() -> None:
    """Run per-package and cross-package checks."""
    parser = argparse.ArgumentParser(description="Check all packages")
    parser.add_argument(
        "--cross-only", action="store_true", help="Skip per-package checks, only run cross-package checks"
    )
    args = parser.parse_args()

    packaged_files: dict[str, list[str]] = {}
    excluded_files: dict[str, list[str]] = {}
    licenses_files: dict[str, list[str]] = {}

    for pkg_dir in sorted(Path("ubuntu/package").iterdir()):
        name = pkg_dir.name
        try:
            pkg = Package(name)
        except PackageError as e:
            print(f"EE: {e}", file=sys.stderr)
            for f in e.files:
                print(f"    {f}", file=sys.stderr)
            sys.exit(1)

        if not args.cross_only:
            print(f"II: Run checks for package: {name}")
            try:
                pkg.check()
            except PackageError as e:
                print(f"EE: {e}", file=sys.stderr)
                for f in e.files:
                    print(f"    {f}", file=sys.stderr)
                sys.exit(1)
            print()

        if not pkg.is_native:
            packaged_files[name] = pkg.files.paths()
            excluded_files[name] = pkg.files.paths("excluded")
            licenses_files[name] = pkg.licenses.paths()

    print("II: Run cross-package checks")

    all_git_files = set(git.Repo().git.ls_files().splitlines())
    all_packaged = {f for files in packaged_files.values() for f in files}
    all_excluded = {f for files in excluded_files.values() for f in files}
    all_licenses = {f for files in licenses_files.values() for f in files}
    unpackaged_files = set(PackageFiles(Path("ubuntu/unpackaged")).paths())

    print("II: Check that different packages don't contain the same file(s)")
    seen: dict[str, list[str]] = {}
    for name, files in packaged_files.items():
        for f in files:
            seen.setdefault(f, []).append(name)

    fail = False
    for f, packages in sorted(seen.items()):
        if len(packages) > 1:
            fail = True
            print(f"EE: Multiple packages provide: {f}", file=sys.stderr)
            for name in packages:
                print(f"    - {name}", file=sys.stderr)
    if fail:
        print("EE: Check failed", file=sys.stderr)
        sys.exit(1)

    print("II: Check that excluded files are not listed in ubuntu/unpackaged")
    bad = sorted(all_excluded & unpackaged_files)
    if bad:
        print("EE: Incorrectly listed files in ubuntu/unpackaged:", file=sys.stderr)
        for f in bad:
            print(f"    - {f}", file=sys.stderr)
        print("EE: Check failed", file=sys.stderr)
        sys.exit(1)

    print("II: Check that all files are packaged or explicitly excluded")
    all_accounted = all_packaged | all_excluded | unpackaged_files | all_licenses
    missing = sorted(all_git_files - all_accounted)
    if missing:
        print("EE: Unpackaged files:", file=sys.stderr)
        for f in missing:
            print(f"    - {f}", file=sys.stderr)
        print("EE: Check failed", file=sys.stderr)
        sys.exit(1)

    print("II: All checks passed")


if __name__ == "__main__":
    main()
