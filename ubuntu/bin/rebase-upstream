#!/usr/bin/env python3
#
# Rebase onto upstream
#

import argparse
import sys
from datetime import UTC, datetime
from pathlib import Path

import git

from lib.package import PackageError, read_upstream

KERNEL_ORG_URL = "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git"
DEFAULT_REV = "kernel.org/main"


def main() -> None:
    """Rebase the current branch onto an upstream commit."""
    parser = argparse.ArgumentParser(description="Rebase onto upstream")
    parser.add_argument(
        "rev",
        nargs="?",
        default=DEFAULT_REV,
        help=f"Revision to rebase to (default: {DEFAULT_REV})",
    )
    args = parser.parse_args()

    repo = git.Repo()

    # Add upstream remote if missing and fetch
    remotes = [r.name for r in repo.remotes]
    if "kernel.org" not in remotes:
        repo.git.remote("add", "kernel.org", KERNEL_ORG_URL)
    print(f"II: Fetch from {KERNEL_ORG_URL}")
    repo.git.fetch("kernel.org")

    # Resolve revision
    try:
        new_commit = repo.git.rev_parse(args.rev)
    except git.GitCommandError:
        print(f"EE: Failed to parse git rev: {args.rev}", file=sys.stderr)
        sys.exit(1)

    new_version = datetime.now(UTC).strftime("%Y%m%d") + f".git{new_commit[:8]}"

    # Rebase
    print(f"II: Rebase to {new_commit}")
    try:
        repo.git.rebase(new_commit)
    except git.GitCommandError as e:
        print(f"EE: Rebase failed: {e}", file=sys.stderr)
        sys.exit(1)

    # Read old commit from ubuntu/upstream (if it exists)
    upstream_path = Path("ubuntu/upstream")
    old_commit = new_commit
    if upstream_path.exists():
        try:
            old_commit, _ = read_upstream()
        except PackageError:
            pass

    # Write new ubuntu/upstream
    upstream_path.write_text(
        f"COMMIT={new_commit}\nVERSION={new_version}\n",
        encoding="utf-8",
    )

    # Build commit message
    log_output = repo.git.log("--no-merges", "--reverse", "--format=- %s", f"{old_commit}..{new_commit}")
    message = (
        f"UBUNTU: Rebase to upstream commit {new_commit}\n\nRebase against {KERNEL_ORG_URL}\n{new_commit}\n{log_output}"
    )

    repo.git.add("ubuntu/upstream")
    repo.git.commit("-s", "-m", message)


if __name__ == "__main__":
    main()
