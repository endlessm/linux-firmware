#!/bin/bash -eu
#
# List package changes since the previous release
#

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

if [ $# != 1 ] ; then
	echo "Usage: $(basename "${0}") <package>" >&2
	exit 2
fi

package=${1}

pkg_dir=ubuntu/package/"${package}"
if ! [ -e "${pkg_dir}"/control ] ; then
	echo "EE: Invalid package name: ${package}" >&2
	exit 1
fi

trap out EXIT INT TERM HUP

# Current upstream commit and version
. ubuntu/upstream

if [ -e "${pkg_dir}"/changelog ] ; then
	version=$(dpkg-parsechangelog -l "${pkg_dir}"/changelog -S Version)
else
	version=${VERSION}-0ubuntu
fi

# Find the previous package release
prev_release=$(git log --format="%H %s" "${COMMIT}".. | \
               grep -F "UBUNTU: Ubuntu-${package}-${version}" || true)

if [ -z "${prev_release}" ] ; then
	# Find the previous rebase release
	prev_release=$(git log --format="%H %s" "${COMMIT}".. | \
	               grep -F "UBUNTU: Ubuntu-${version}" || true)
fi

if [ -z "${prev_release}" ] ; then
	# Initial commit
	prev_release=${COMMIT}
fi

readarray -t package_files < <(grep -E '^[0-9a-zA-Z:]' "${pkg_dir}"/files)

package_files+=(
	"ubuntu/debian/"
	"ubuntu/package/${package}/"
	"ubuntu/templates/"
	"ubuntu/upstream"
)

git log --no-merges --format="%h %s" "${prev_release%% *}".. -- "${package_files[@]}"
