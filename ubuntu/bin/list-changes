#!/bin/bash -eu
#
# List package changes since the previous release
#

function out()
{
	local rc=${?}

	trap - EXIT INT TERM HUP
	test ${rc} -eq 0 || echo "EE: Script failed" >&2
	exit "${rc}"
}

if [ $# != 1 ] ; then
	echo "Usage: $(basename "${0}") <package>" >&2
	exit 2
fi

package=${1}

case "${package}" in
	meta)
		is_meta=1
		changelog=ubuntu/meta/debian/changelog
		;;
	*)
		is_meta=0
		changelog=ubuntu/package/${package}/changelog
		;;
esac

if ! [ -e "${changelog}" ] ; then
	echo "EE: Invalid package name: ${package}" >&2
	exit 2
fi

trap out EXIT INT TERM HUP

# Current upstream commit and version
. ubuntu/upstream

#
# Find the previous release commit
#

# Get the last commit that touched the first line of the changelog
blame=$(git blame -L 1,1 "${changelog}")
echo "II: Previous release: ${blame}" >&2

# Sanity checks
version=$(dpkg-parsechangelog -l "${changelog}" -S Version)
case "${blame}" in
	00000000*)
		echo "EE: Uncommited changes" >&2
		exit 1
		;;
	*" (${version}) "*)
		true
		;;
	*)
		echo "EE: Previous release version looks incorrect (should be ${version})" >&2
		exit 1
		;;
esac

prev_release=${blame%% *}

if [ ${is_meta} -eq 0 ] ; then
	readarray -t package_files < <(grep -E '^[0-9a-zA-Z:]' ubuntu/package/"${package}"/files)
	package_files+=(
		"ubuntu/debian/"
		"ubuntu/package/${package}/"
		"ubuntu/templates/"
		"ubuntu/upstream"
	)
else
	package_files=(
		"ubuntu/meta/debian/"
	)
fi

git log --no-merges --format="%h %s" "${prev_release}".. -- "${package_files[@]}"
