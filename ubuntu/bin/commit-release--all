#!/bin/bash -eu
#
# Commit all package releases
#

# Sanity check
./ubuntu/bin/check-package--all

# Current upstream commit and version
# shellcheck disable=SC1091
. ubuntu/upstream

rebase_release=1

for d in ubuntu/package/* ; do
	package=${d##*/}
	if [ "${package}" = "meta" ] ; then
		rebase_version=${VERSION}.1ubuntu
	else
		rebase_version=${VERSION}-0ubuntu1
	fi

	version=$(dpkg-parsechangelog -l "${d}"/changelog -S Version)
	if [ "${version}" != "${rebase_version}" ] ; then
		rebase_release=0
	fi
done

# This is a rebase release (all packages, same version)
if [ ${rebase_release} -eq 1 ] ; then
	echo
	echo "II: Commit and tag rebase release"
	git add ubuntu/package/*/changelog
	git commit -s -m "UBUNTU: Ubuntu-${version}"
	ubuntu/bin/tag-release
	exit 0
fi

for d in ubuntu/package/* ; do
	if [ -n "$(git status --porcelain -- "${d}"/changelog)" ] ; then
		ubuntu/bin/commit-release --no-check "${d##*/}"
	fi
done
