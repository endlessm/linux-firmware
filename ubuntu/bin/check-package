#!/usr/bin/env python3
#
# Check a package
#

import argparse
import sys

from lib.package import Package, PackageError


def main() -> None:
    """Parse arguments and list package files."""
    parser = argparse.ArgumentParser(description="Check a package")
    parser.add_argument("package", help="Package name")
    parser.add_argument(
        "commit",
        nargs="?",
        default=None,
        help="Commit to check package at (default: None)",
    )
    args = parser.parse_args()

    print(f"II: Run checks for package: {args.package}")
    try:
        pkg = Package(args.package, args.commit)
        pkg.check()
    except PackageError as e:
        print(f"EE: {e}", file=sys.stderr)
        for f in e.files:
            print(f"    {f}", file=sys.stderr)
        sys.exit(1)
    except OSError as e:
        print(f"EE: Script failed: {e}", file=sys.stderr)
        sys.exit(1)

    print("II: All checks passed")
    sys.exit(0)


if __name__ == "__main__":
    main()
