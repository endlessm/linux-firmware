#!/bin/bash -eu
#
# Build a binary package and run lintian on it
#

pkg=${1}

ubuntu/bin/build-package "${pkg}" -- -b

echo "II: Run lintian"

changelog=ubuntu/package/${pkg}/changelog
package=$(dpkg-parsechangelog -l "${changelog}" -S source)
version=$(dpkg-parsechangelog -l "${changelog}" -S version)

if lintian ../"${package}"_"${version}"_all.deb ; then
	echo "II: PASS"
else
	echo "EE: FAIL" >&2
fi
