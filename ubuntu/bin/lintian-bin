#!/bin/bash -eu
#
# Build a binary package and run lintian on it
#

pkg=${1}

echo "II: Run lintian on package: ${pkg}"

changelog=ubuntu/package/${pkg}/changelog

s=$(dpkg-parsechangelog -l "${changelog}" -S Source)
v=$(dpkg-parsechangelog -l "${changelog}" -S Version)

deb=../${s}_${v}_all.deb
if ! [ -e "${deb}" ] ; then
	echo "EE: Not found: ${deb}" >&2
	exit 1
fi

lintian "${deb}" || true
