#!/usr/bin/env python3
#
# Trim WHENCE file sections
#

import sys


def yield_sections(whence_file):
    with open(whence_file, encoding="utf-8") as fh:
        section = []
        for line in fh:
            if line.startswith("--------"):
                if section:
                    yield section
                    section = []
            else:
                if line.split(":")[0] in ("File", "RawFile", "Link"):
                    # Replace "\ " (backslash space) with a single space and
                    # remove single-quotes (') and double-quotes (")
                    line = line.replace(r"\ ", " ").replace("'", "").replace('"', "")
                section.append(line.rstrip())

        if section:
            yield section


package_filelist = sys.argv[1]
whence_files = sys.argv[2:]

# Read the list of packaged files
with open(package_filelist, encoding="utf-8") as fh:
    package_files = [line.strip() for line in fh]

# Read the WHENCE sections
whence_sections = []
for f in whence_files:
    whence_sections.extend(list(yield_sections(f)))

# Print the header
for line in whence_sections[0]:
    print(line)

# Print the sections that reference the packaged files
found = False
for section in whence_sections:
    for line in section:
        if line.startswith("File:") or line.startswith("RawFile:"):
            f = line.split(":", 1)[1].strip()
            if f in package_files:
                found = True
                print("-" * 78)
                print("\n".join(section))
                break

print("-" * 78)
